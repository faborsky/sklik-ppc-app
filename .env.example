# Default account — used when --account is omitted.
SKLIK_API_TOKEN=your-api-token-here

# Optional: additional named logins. Each --account <name> reads
# SKLIK_API_TOKEN_<NAME>. Add as many as you need (or delete this).
# Example below is selected with: --account clientb
# SKLIK_API_TOKEN_CLIENTB=your-other-api-token-here
